# Copy to .env.local and adjust. Never put secrets in NEXT_PUBLIC_ variables.

# Mal3abi.BE origin (server-only). The browser calls /api on this site, which proxies here.
API_BASE_URL=https://localhost:7082

# Public URL of this website, used for canonical and hreflang links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "enabled" serves mock data in the browser (MSW) until the backend contract exists.
NEXT_PUBLIC_API_MOCKING=enabled
